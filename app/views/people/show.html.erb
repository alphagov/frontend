<% content_for :title, build_page_title([content_item.title]) %>

<% content_for :head do %>
  <meta name="description" content="<%= content_item.description %>">
  <%= render "govuk_publishing_components/components/machine_readable_metadata", {
    schema: :person,
    content_item: content_item.to_h,
  } %>
<% end %>

<%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-one-third">
    <%= render "image", person: content_item %>
    <%= render "contents", person_presenter: content_item_presenter %>
  </div>

  <div class="govuk-grid-column-two-thirds">
    <%= render "biography", person: content_item %>
    <%= render "current_roles", person: content_item %>
    <%= render "previous_roles", person: content_item, person_presenter: content_item_presenter %>
    <%= render "shared/announcements", announcements: content_item_presenter.announcements %>
  </div>
</div>
