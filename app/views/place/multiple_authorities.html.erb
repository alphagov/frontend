<% content_for :title, "Error: #{page_title(content_item)}" if @location_error %>
<% content_for :title, "#{content_item.title}: #{t('formats.local_transaction.select_address').downcase} - GOV.UK" %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>
<% end %>

<% content_for :content do %>
  <%= render "govuk_publishing_components/components/heading", {
    text: t("formats.place.postcode"),
    heading_level: 2,
    margin_bottom: 2,
  } %>

  <p class="govuk-body">
    <strong><%= @postcode %></strong> <%= link_to t("common.change"), @change_path, class: "govuk-link" %>
  </p>

  <%= form_tag(@onward_path, method: :post) do -%>
    <%= hidden_field_tag :postcode, @postcode %>
    <% if @options.count > 6 %>
      <%= render "govuk_publishing_components/components/select", {
        id: "local_authority_slug",
        label: t("formats.place.select_address"),
        options: @options,
      } %>
    <% else %>
      <%= render "govuk_publishing_components/components/radio", {
        id: "local_authority_slug",
        name: "local_authority_slug",
        heading: t("formats.place.select_address"),
        heading_size: "s",
        items: @options,
      } %>
    <% end %>

    <%= render "govuk_publishing_components/components/button", {
      text: t("continue"),
    } %>
  <% end %>
<% end %>

<% content_for :sidebar do %>
  <%= render "govuk_publishing_components/components/contextual_sidebar", content_item: content_item.to_h %>
<% end %>

<% content_for :footer do %>
  <%= render "govuk_publishing_components/components/contextual_footer", content_item: content_item.to_h %>
<% end %>
