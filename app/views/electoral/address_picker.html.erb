<% content_for :head do %>
  <meta name="robots" content="noindex">
  <% if content_item.description.present? %>
    <meta name="description" content="<%= content_item.description %>">
  <% end %>
<% end %>

<% title = t("formats.local_transaction.choose_address") %>
<% content_for :title, title %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options.merge({ heading_text: title }) %>
<% end %>

<% content_for :content do %>
  <div class="content-bottom-margin">
    <p class="govuk-body">
      The <strong><%= @postcode.sanitized_postcode %></strong> postcode could be in several council areas. Please choose your address from the list below.
    </p>

    <% if @presenter.addresses.present? %>
      <% items = @presenter.addresses.map { |a| { text: a["address"], value: a["slug"] } } %>

      <%= form_with url: electoral_services_path, method: :get do |form| %>
        <%= render "govuk_publishing_components/components/select", {
          id: "uprn",
          name: "uprn",
          label: t("formats.local_transaction.select_address"),
          options: items,
        } %>

        <%= render "govuk_publishing_components/components/button", text: t("continue"), margin_bottom: true %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= content_for :sidebar do %>
  <%= render "govuk_publishing_components/components/contextual_sidebar", content_item: @content_item.to_h %>
<% end %>

<%= content_for :footer do %>
  <%= render "govuk_publishing_components/components/contextual_footer", content_item: @content_item.to_h, dir: page_text_direction %>
<% end %>
