<% content_for :head do %>
  <meta name="description" content="<%= content_item.description %>">
  <%= render "govuk_publishing_components/components/machine_readable_metadata", {
    content_item: content_item.to_h,
    schema: :article,
    canonical_url: Plek.new.website_root + content_item.current_part_path,
    body: current_guide_part_body.presence,
  } %>
  <%= postal_vote_video_ab_test_variant.analytics_meta_tag.html_safe if postal_vote_video_ab_test_page? %>
<% end %>

<% content_for :title do %>
  <%= content_item_presenter.page_title %> - GOV.UK
<% end %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>
<% end %>

<% content_for :content do %>
  <% if content_item.first_part? %>
    <script type="application/ld+json">
      <%= raw JSON.pretty_generate(MachineReadable::GuideFaqPageSchemaPresenter.new(content_item, image_url("govuk_publishing_components/govuk-logo.png")).structured_data) %>
    </script>
  <% end %>

  <% if content_item_presenter.show_guide_navigation? %>
    <%= render "govuk_publishing_components/components/skip_link", {
      text: t("formats.guide.skip_contents"),
      href: "#guide-contents",
    } %>

    <%= render "govuk_publishing_components/components/contents_list",
      aria: { label: t("formats.guide.pages_in_guide") },
      contents: part_link_elements(content_item.parts, content_item.current_part, draft_token:),
      underline_links: true,
      margin_bottom: 8 %>
  <% end %>

  <div id="guide-contents">
    <% if content_item.parts.any? %>
      <% if content_item_presenter.show_guide_navigation? %>
        <%= render "govuk_publishing_components/components/heading",
          text: content_item.current_part_title,
          heading_level: 1,
          font_size: "xl",
          margin_bottom: 6 %>
      <% end %>

      <% video_transcript = postal_vote_video_transcript %>

      <%= render "govuk_publishing_components/components/govspeak", {
        direction: page_text_direction,
        disable_youtube_expansions: !content_item.is_child_benefit? && !show_postal_vote_video?,
        classes: ("app-c-postal-vote-video" if show_postal_vote_video?),
      } do %>
        <% if video_transcript&.present? %>
          <%= raw(video_transcript.before_html) %>

          <%= render "govuk_publishing_components/components/details", {
            title: "Transcript",
          } do %>
            <%= raw(video_transcript.transcript_html) %>
          <% end %>

          <%= raw(video_transcript.after_html) %>
        <% else %>
          <%= raw(current_guide_part_body) %>
        <% end %>
      <% end %>

      <% if content_item_presenter.show_guide_navigation? %>
        <%= render "govuk_publishing_components/components/pagination",
          previous_and_next_navigation(content_item.previous_part, content_item.next_part, draft_token:) %>

        <div class="responsive-bottom-margin">
          <a href="<%= print_link(content_item.base_path) %>"
            class="govuk-link govuk-link--no-visited-state govuk-body"
            data-module="ga4-link-tracker"
            data-ga4-link="<%= {
              event_name: "navigation",
              type: "print page",
              section: "Footer",
              text: t("multi_page.print_entire_guide", locale: :en),
            }.to_json %>">
            <%= t("multi_page.print_entire_guide") %>
          </a>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<% content_for :sidebar do %>
  <%= render "govuk_publishing_components/components/contextual_sidebar", content_item: @content_item.to_h %>
<% end %>

<% content_for :footer do %>
  <%= render "govuk_publishing_components/components/contextual_footer", content_item: @content_item.to_h, dir: page_text_direction %>
<% end %>
