<% content_for :head do %>
  <%= render "govuk_publishing_components/components/machine_readable_metadata",
    schema: :article,
    content_item: content_item.to_h %>
<% end %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>
<% end %>

<% content_for :content do %>
  <%= render "govuk_publishing_components/components/govspeak" do %>
    <%= raw content_item.body %>
  <% end %>

  <%= render "govuk_publishing_components/components/button",
    text: content_item_presenter.start_button_text.html_safe,
    rel: "nofollow",
    start: true,
    margin_bottom: 9,
    href: smart_answer_flow_path(slug: content_item.slug, edition: @edition),
    data_attributes: {
      module: "ga4-link-tracker",
      ga4_link: {
        event_name: "form_start",
        type: "simple smart answer",
        section: "start page",
        action: "start",
        tool_name: content_item.title,
      },
    } %>
<% end %>

<% content_for :sidebar do %>
  <%= render "govuk_publishing_components/components/contextual_sidebar", content_item: content_item.to_h %>
<% end %>

<% content_for :footer do %>
  <%= render "govuk_publishing_components/components/contextual_footer", content_item: content_item.to_h %>
<% end %>
