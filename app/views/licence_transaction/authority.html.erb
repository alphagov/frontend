<% content_for :title, "#{content_item.title}: #{licence_details.authority['name']} - GOV.UK" %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>
<% end %>

<% content_for :content do %>
  <%= render "authority_base" do %>
    <%= render "govuk_publishing_components/components/govspeak", {} do %>
      <%= raw content_item.body %>
    <% end %>
  <% end %>
<% end %>

<%= render partial: "shared/header_content_sidebar_common" %>
