<% content_for :head do %>
    <meta name="description" content="<%= content_item.description %>">
    <% if content_item_presenter.hide_from_search_engines? %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <%= render "govuk_publishing_components/components/machine_readable_metadata",
    schema: :article,
    content_item: content_item.to_h %>
<% end %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options %>
<% end %>

<% content_for :content do %>
  <% if content_item_presenter.important_metadata.any? && content_item_presenter.show_metadata_block? %>
    <%= content_tag :div, class: "important-metadata inverse-background responsive-bottom-margin" do %>
      <%= render "govuk_publishing_components/components/metadata", {
        inverse: true,
        other: content_item_presenter.important_metadata,
        margin_bottom: 0,
      } %>
    <% end %>
  <% end %>

  <%= render "govuk_publishing_components/components/contents_list_with_body", contents: content_item_presenter.headers_for_contents_list_component(nested_headers: true, visible: content_item_presenter.show_table_of_contents?) do %>

    <% if content_item_presenter.show_protection_type_image? %>
      <%= render "govuk_publishing_components/components/figure", {
        src: image_path(content_item_presenter.protection_image_path),
        alt: content_item_presenter.protection_image_alt_text,
      } %>
    <% end %>

    <div class="responsive-bottom-margin">
      <%= render "govuk_publishing_components/components/govspeak", {
        direction: page_text_direction,
      } do %>
        <%= raw(content_item.body.html_safe) %>
      <% end %>

      <% if content_item.continuation_link %>
        <%= render "govuk_publishing_components/components/button", {
          href: content_item.continuation_link.html_safe,
          info_text: content_item.will_continue_on&.html_safe,
          start: true,
          text: "Find out more",
        } %>
      <% end %>
    </div>

    <% if content_item_presenter.show_finder_link? %>
      <div class="responsive-bottom-margin">
        <%= govuk_styled_link("See all #{content_item.finder.title}",
                              path: content_item.finder.base_path) %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% content_for :sidebar do %>
  <%= render "govuk_publishing_components/components/contextual_sidebar", content_item: @content_item.to_h %>
<% end %>

<% content_for :footer do %>
  <%= render "govuk_publishing_components/components/contextual_footer", content_item: @content_item.to_h, dir: page_text_direction %>
<% end %>
