<% if person.has_previous_non_ministerial_roles? %>
  <div class="previous-roles govuk-!-padding-bottom-9" id="previous-roles">
    <%= render "govuk_publishing_components/components/heading", {
      text: t("formats.people.previous_roles_in_government"),
      margin_bottom: 2,
    } %>

    <%= render "govuk_publishing_components/components/document_list", {
      items: person_presenter.previous_roles_items,
    } %>
  </div>
<% end %>
