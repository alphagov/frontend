<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <% hero = @content_item_presenter.random_hero %>
    <%= render "govuk_publishing_components/components/heading", {
      text: "GOV.UK Publishing heroes",
      heading_level: 1,
      font_size: "xl",
      margin_bottom: 6,
    } %>

    <%= render "govuk_publishing_components/components/lead_paragraph", {
      text: "This page commemorates one of many people who have worked to make www.gov.uk a success.",
      margin_bottom: 6,
    } %>

    <%= render "govuk_publishing_components/components/heading", {
      text: hero[:name],
      heading_level: 2,
      font_size: "l",
    } %>

    <p class="govuk-body">
      <%= raw hero[:text] %>
    </p>
  </div>
</div>
