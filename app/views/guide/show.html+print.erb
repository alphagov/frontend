<%
  content_for :title, "Print #{content_item.title} - GOV.UK"
  content_for :head do
%>
  <meta name="robots" content="noindex, nofollow">
  <%= stylesheet_link_tag "views/_guide", media: "all" %>
<% end %>

<% content_for :header do %>
  <%= render "shared/headers/page_title", options: content_item_presenter.page_title_options.merge({
    lead_paragraph: t("multi_page.printable_version"),
  }) %>
<% end %>

<% content_for :content do %>
  <div id="guide-print">
    <%= render "govuk_publishing_components/components/print_link", {
      margin_bottom: 8,
    } %>

    <% content_item.parts.each_with_index do |part, index| %>
      <section>
        <%= render "govuk_publishing_components/components/heading", {
          text: "#{index + 1}. #{part['title']}",
          heading_level: 1,
          font_size: "l",
          margin_bottom: 4,
        } %>

        <%= render "govuk_publishing_components/components/govspeak",
          content: part["body"].html_safe,
          direction: page_text_direction,
          disable_youtube_expansions: true,
          margin_bottom: 8 %>
      </section>
    <% end %>

    <%= render "govuk_publishing_components/components/print_link" %>
  </div>
<% end %>
