<% content_for :head do %>
  <%= stylesheet_link_tag "views/_sidebar-navigation", media: "all" %>
<% end %>

<% sidebar_content = capture do %>
  <%= render "govuk_publishing_components/components/contextual_sidebar", content_item: @content_item.to_h %>
<% end %>

<% if !sidebar_content.empty? && !sidebar_content.blank? && !sidebar_content.nil? && sidebar_content.strip != "" && sidebar_content.present? %>
  <div class="govuk-grid-column-one-third sidebar-navigation">
    <%= sidebar_content %>
  </div>
<% end %>

