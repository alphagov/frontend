<%= render "govuk_publishing_components/components/heading", {
  text: options[:heading_text],
  font_size: "l",
  padding: true,
  border_top: 5,
  margin_bottom: 3,
} %>

<%= render "govuk_publishing_components/components/document_list", {
  margin_bottom: 5,
  items: options[:items].first(5),
  ga4_extra_data: {
    section: options[:heading_text],
  },
} %>

<%= tag.p(class: "govuk-body", data: { module: "ga4-link-tracker", ga4_link: { event_name: "navigation", type: "see all", section: options[:heading_text] }.to_json }) do %>
  <%= link_to(options[:see_all_items_link_text], options[:see_all_items_link], class: "govuk-link") %>
<% end %>

<%= render "govuk_publishing_components/components/subscription_links", {
  email_signup_link: options[:email_signup_link],
  email_signup_link_text: options[:email_signup_link_text],
  data_attributes: {
    module: "ga4-link-tracker",
    ga4_link: { "event_name": "navigation", "type": "subscribe", "index_link": 1, "index_total": 1, "section": options[:heading_text] }.to_json,
  },
  margin_bottom: 8,
} %>
